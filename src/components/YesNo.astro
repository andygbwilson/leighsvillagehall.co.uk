---
type Props = {
  name: string;
  required?: boolean;
};

const { name, required = false } = Astro.props;
---

<div class="ha-choice">
  <label>
    <input type="radio" name={name} value="yes" required={required} />
    Yes
  </label>
  <label>
    <input type="radio" name={name} value="no" required={required} />
    No
  </label>
</div>
