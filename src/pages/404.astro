---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found on the Leighs Village Hall website.">
  <section class="page-hero wrap">
    <h1>Page not found</h1>
    <p>Sorry, that page is not on this site. Try the links below, or go back to the home page.</p>
    <div class="actions">
      <a class="button button-primary" href="/">Home</a>
      <a class="button button-secondary" href="/bookings">Bookings</a>
      <a class="button button-secondary" href="/facilities">Facilities</a>
    </div>
  </section>
</BaseLayout>
