---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from '../../components/AdminNav.astro';
import BookingCalendar from '../../components/BookingCalendar.astro';
import CalendarPrivacyField from '../../components/CalendarPrivacyField.astro';
import RecurrenceSelect from '../../components/RecurrenceSelect.astro';
---

<BaseLayout title="Booking calendar" description="Admin calendar for Leighs Village Hall." noindex>
  <section class="page-hero wrap">
    <p class="kicker">Bookings admin</p>
    <h1>Calendar</h1>
    <p>Set up held dates, including club series for next year. The public can only request dates in the open period.</p>
  </section>
  <section class="section section-paper">
    <div class="wrap">
      <AdminNav />
      <p class="ha-banner is-error" data-admin-error hidden></p>
      <BookingCalendar admin />
      <form class="ha-form card mt-4" data-admin-import>
        <h2>Import from Hall Booking Online</h2>
        <p class="ha-note">
          Best: export <strong>CSV (Full)</strong> from Hall Booking Online (Events Dashboard search, or Export Data). That
          keeps names and emails. You can also import the public calendar, which fills dates, times and rooms without hirer
          contact details.
        </p>
        <label class="ha-field">
          <span>CSV file</span>
          <input name="file" type="file" accept=".csv,text/csv" />
        </label>
        <label class="ha-field">
          <span>Or paste CSV</span>
          <textarea name="csv" rows="6" placeholder="Paste the exported CSV here"></textarea>
        </label>
        <div class="ha-grid">
          <label class="ha-field"><span>Public calendar from</span><input name="from" type="date" /></label>
          <label class="ha-field"><span>Until</span><input name="to" type="date" /></label>
        </div>
        <div class="actions">
          <button class="button button-primary" type="submit">Import CSV</button>
          <button class="button button-secondary" type="button" data-import-calendar>Import public calendar</button>
        </div>
      </form>
      <form class="ha-form card mt-4" data-admin-copy-year>
        <h2>Copy bookings into a new year</h2>
        <p class="ha-note">Copies club and held dates from one year to another, skipping any clashes. Recurring series are expanded again.</p>
        <div class="ha-grid">
          <label class="ha-field"><span>From year</span><input name="fromYear" type="number" min="2020" required /></label>
          <label class="ha-field"><span>To year</span><input name="toYear" type="number" min="2020" required /></label>
        </div>
        <div class="actions">
          <button class="button button-primary" type="submit">Copy into that year</button>
        </div>
      </form>
      <form class="ha-form card mt-4" id="new-booking" data-admin-hold>
        <h2>Hold a date or series</h2>
        <p class="ha-note">Use this for clubs and other bookings you are placing yourselves, including next year.</p>
        <div class="ha-grid">
          <label class="ha-field"><span>Name</span><input name="hirerName" required /></label>
          <label class="ha-field"><span>Email</span><input name="email" type="email" /></label>
          <label class="ha-field"><span>Telephone</span><input name="telephone" type="tel" /></label>
        </div>
        <div class="ha-grid">
          <label class="ha-field"><span>Date</span><input name="hireDate" type="date" required /></label>
          <label class="ha-field"><span>From</span><input name="timeFrom" type="time" required /></label>
          <label class="ha-field"><span>To</span><input name="timeTo" type="time" required /></label>
        </div>
        <div class="ha-choice" data-room-choices></div>
        <label class="ha-field">
          <span>Event title</span>
          <input name="functionType" type="text" />
        </label>
        <CalendarPrivacyField />
        <label class="ha-field">
          <span>Event description</span>
          <textarea name="eventDescription" rows="2"></textarea>
        </label>
        <label class="ha-check">
          <input name="isRecurring" type="checkbox" value="true" data-admin-recurring />
          <span>Recurring booking</span>
        </label>
        <div class="ha-grid" data-recurrence-fields hidden>
          <RecurrenceSelect />
          <label class="ha-field"><span>Until</span><input name="recurrenceUntil" type="date" /></label>
        </div>
        <label class="ha-field"><span>Notes</span><textarea name="notes" rows="2"></textarea></label>
        <div class="actions">
          <button class="button button-primary" type="submit">Save on calendar</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/booking-calendar';
  import '../../scripts/admin-calendar';
</script>
