---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Hire agreements" description="Review hire agreements submitted for Leighs Village Hall." noindex>
  <section class="page-hero wrap">
    <p class="kicker">Bookings admin</p>
    <h1>Hire agreements</h1>
    <p>Open a booking to check the details, then send the hire agreement invite when you are ready.</p>
  </section>

  <section class="section section-paper">
    <div class="wrap" data-admin-list>
      <div class="admin-toolbar">
        <label class="ha-field admin-search">
          <span>Search</span>
          <input type="search" data-admin-search placeholder="Name, email or booking number" />
        </label>
        <button class="button button-secondary" type="button" data-admin-logout>Sign out</button>
      </div>
      <p class="ha-banner is-error" data-admin-error hidden></p>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Time</th>
              <th>Hirer</th>
              <th>Booking</th>
              <th>Status</th>
              <th>Invite</th>
            </tr>
          </thead>
          <tbody data-admin-rows>
            <tr><td colspan="6">Loading hire agreements…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../../scripts/admin-agreements-list';
</script>
