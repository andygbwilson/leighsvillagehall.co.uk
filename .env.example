# Optional override. Defaults to project lc8qwfpd / production.
PUBLIC_SANITY_PROJECT_ID=lc8qwfpd
PUBLIC_SANITY_DATASET=production

# Only needed for the seed script (never commit this).
SANITY_WRITE_TOKEN=

# Local bookings admin password (`npm run dev`). Production uses `wrangler secret put HIRE_ADMIN_PASSWORD`.
# First sign-in at /admin/login with HIRE_ADMIN_EMAIL plus this password creates the booking secretary account.
HIRE_ADMIN_EMAIL=leighsvillagehall@gmail.com
HIRE_ADMIN_EXTRA=andygbwilson@gmail.com
HIRE_ADMIN_PASSWORD=lvh-admin-dev

# Cloudflare Turnstile on the public booking enquiry. Dummy keys always pass locally.
# Staging/production: create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Bake PUBLIC_TURNSTILE_SITE_KEY into the Astro build, then store the secret on the Worker:
# npx wrangler secret put TURNSTILE_SECRET_KEY --env staging
# npx wrangler secret put TURNSTILE_SECRET_KEY
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Staging (`npm run deploy:staging`) uses `.env.staging` and Wrangler env `staging`.
# Set the staging admin password with:
# npx wrangler secret put HIRE_ADMIN_PASSWORD --env staging
